# Google OAuth2 - get from console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Gemini AI - get from aistudio.google.com (free)
GEMINI_API_KEY=your_gemini_api_key

# Redis - local or Railway
REDIS_URL=redis://localhost:6379

# Session secret - any random string
SESSION_SECRET=change_this_to_a_random_secret_string

# Encryption key for OAuth tokens (32 chars)
ENCRYPTION_KEY=change_this_32_char_encryption_key

# Frontend URL
FRONTEND_URL=http://localhost:3000

PORT=3001
